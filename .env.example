# Copy to .env (local) and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Postgres. Local: `docker compose up -d` gives you this exact URL.
# Production: a Neon / Supabase / Vercel Postgres connection string (add ?sslmode=require).
DATABASE_URL="postgresql://leadpilot:leadpilot@127.0.0.1:5433/leadpilot"

# Leave empty (or set DEMO_MODE="true") to run in demo mode: a scripted agent, no API credits needed.
DEMO_MODE=""

# Claude API key from https://platform.claude.com (Settings -> API keys).
ANTHROPIC_API_KEY=""

# --- Optional ---------------------------------------------------------------
# Second provider: any OpenAI-compatible API. Used when ANTHROPIC_API_KEY is empty and these are set
# (or force it with LLM_PROVIDER="openai"; force Claude with LLM_PROVIDER="anthropic").
#   Gemini (free tier): OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"  OPENAI_MODEL="gemini-3.5-flash-lite"
#   Groq (free tier):   OPENAI_BASE_URL="https://api.groq.com/openai/v1"                            OPENAI_MODEL="llama-3.3-70b-versatile"
#   Ollama (local):     OPENAI_BASE_URL="http://localhost:11434/v1"  OPENAI_MODEL="llama3.1"        (key not needed)
LLM_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL=""

# Model used by the agent and the reply triage. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL="claude-opus-5-5"

# Who the outreach is from. Used in the agent's system prompt.
SENDER_NAME="Alex"
SENDER_COMPANY="Your Studio"
SENDER_OFFER="fast websites, WhatsApp click-to-chat and lead-capture automation for local businesses"
PORTFOLIO_URL="https://example.com"
BOOKING_URL=""

# Google Places API (Text Search, New). When set, the agent gets a `find_new_businesses` tool.
GOOGLE_PLACES_API_KEY=""

# Email finder: store info@domain as a GUESSED email when the domain has MX records (default true).
GUESS_EMAILS="true"
# Allow drafting emails to GUESSED addresses (default false - they may bounce).
ALLOW_GUESSED_EMAILS="false"

# Protects the whole app with HTTP Basic auth (user: any, password: this). Set it on any public deploy,
# otherwise anyone with the URL can spend your Claude credits.
APP_PASSWORD=""

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/followups.
CRON_SECRET=""
